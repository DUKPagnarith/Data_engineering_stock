# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Stock Prediction System — Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Finnhub API Key (primary real-time source)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Default ticker symbol
DEFAULT_TICKER=AAPL

# Backfill period in years (for yfinance historical ingestion)
BACKFILL_YEARS=2

# Raw data output directory
RAW_DATA_DIR=data/raw

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PostgreSQL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
POSTGRES_DB=stock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_HOST=stock_postgres
POSTGRES_PORT=5433

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# pgAdmin
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
PGADMIN_EMAIL=admin@stock.com
PGADMIN_PASSWORD=admin123
